{
  "name": "@houkunlin/bpmn-js-react",
  "version": "0.0.10",
  "description": "A react library developed with dumi",
  "license": "MIT",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "father build",
    "build:watch": "father dev",
    "dev": "dumi dev",
    "docs:build": "dumi build",
    "doctor": "father doctor",
    "lint": "npm run lint:es && npm run lint:css",
    "lint:css": "stylelint \"{src,test}/**/*.{css,less}\"",
    "lint:es": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
    "prepare": "husky install && dumi setup",
    "prepublishOnly": "father doctor && npm run build",
    "start": "npm run dev"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{css,less}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --parser=typescript --write"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@bpmn-io/properties-panel": "^3.35.1",
    "ahooks": "^3.9.6",
    "bpmn-js": "^18.10.1",
    "bpmn-js-embedded-comments": "^0.7.0",
    "bpmn-js-properties-panel": "^5.46.0",
    "bpmn-js-token-simulation": "^0.38.2",
    "bpmn-moddle": "^9.0.4",
    "camunda-bpmn-moddle": "^7.0.1",
    "classnames": "^2.5.1",
    "diagram-js": "^15.5.0",
    "diagram-js-minimap": "^5.2.0",
    "lodash": "^4.17.21",
    "react-dev-inspector": "^2.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@emotion/css": "^11.13.5",
    "@types/lodash": "^4.17.17",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@uidotdev/usehooks": "^2.4.1",
    "@umijs/lint": "^4.4.11",
    "dumi": "^2.4.21",
    "eslint": "^9.27.0",
    "father": "^4.5.5",
    "husky": "^9.1.7",
    "less": "^4.3.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^2.5.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^6.1.18",
    "stylelint": "^16.19.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "authors": [
    "houkunlin <houkunlin@aliyun.com>"
  ]
}
